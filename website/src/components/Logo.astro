---
interface Props {
  variant?: 'mark' | 'wordmark' | 'lockup';
  tone?: 'navy' | 'white';
  size?: number; // px height of the mark
  showTagline?: boolean;
  class?: string;
}

const {
  variant = 'lockup',
  tone = 'navy',
  size = 36,
  showTagline = false,
  class: className = '',
} = Astro.props;

const stroke = tone === 'navy' ? '#0B132B' : '#FFFFFF';
const wordColor = tone === 'navy' ? 'text-navy' : 'text-white';
const tagColor = tone === 'navy' ? 'text-navy/55' : 'text-white/65';
const gradientId = `geo-grad-${Math.random().toString(36).slice(2, 9)}`;
---

<span class={`inline-flex items-center gap-3 ${className}`} aria-label="GEO — Generative Engine Optimization">
  {(variant === 'mark' || variant === 'lockup') && (
    <svg
      width={size}
      height={size}
      viewBox="0 0 64 64"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden={variant !== 'mark'}
      role={variant === 'mark' ? 'img' : undefined}
    >
      <defs>
        <linearGradient id={gradientId} x1="22" y1="20" x2="50" y2="48" gradientUnits="userSpaceOnUse">
          <stop offset="0%" stop-color="#2563EB" />
          <stop offset="55%" stop-color="#7C3AED" />
          <stop offset="100%" stop-color="#22D3EE" />
        </linearGradient>
      </defs>

      {/* Outer C-shaped G ring (open on the right where the arrow exits) */}
      <path
        d="M50 18 A 20 20 0 1 0 50 46"
        stroke={stroke}
        stroke-width="5.5"
        stroke-linecap="round"
        fill="none"
      />
      {/* Inner G shelf (the horizontal stroke that makes a G out of a C) */}
      <path
        d="M44 32 H 50"
        stroke={stroke}
        stroke-width="5.5"
        stroke-linecap="round"
      />

      {/* Sparkle / four-point star inside the bowl */}
      <path
        d="M26 32 L29 28 L32 32 L29 36 Z"
        fill={`url(#${gradientId})`}
      />
      <path
        d="M29 24 L30 30 L29 36 L28 30 Z"
        fill={`url(#${gradientId})`}
        opacity="0.55"
      />
      <path
        d="M23 32 L29 31 L35 32 L29 33 Z"
        fill={`url(#${gradientId})`}
        opacity="0.55"
      />

      {/* Gradient arrow tail exiting the G to the lower-right */}
      <path
        d="M40 36 L48 36 L48 44"
        stroke={`url(#${gradientId})`}
        stroke-width="5.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        fill="none"
      />
      <path
        d="M44 40 L48 44 L52 40"
        stroke={`url(#${gradientId})`}
        stroke-width="5.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        fill="none"
      />
    </svg>
  )}

  {(variant === 'wordmark' || variant === 'lockup') && (
    <span class="flex flex-col leading-none">
      <span class={`font-display font-bold tracking-[-0.04em] ${wordColor}`} style={`font-size:${Math.round(size * 0.72)}px`}>
        GEO
      </span>
      {showTagline && (
        <span class={`mt-1 font-mono uppercase tracking-[0.22em] ${tagColor}`} style={`font-size:${Math.max(9, Math.round(size * 0.18))}px`}>
          Generative&nbsp;Engine&nbsp;Optimization
        </span>
      )}
    </span>
  )}
</span>
