---
/**
 * Live "AI answer" demo. Types through real buyer questions and reveals an
 * answer that recommends a firm "via GEO" — demonstrating the core value.
 * Reduced motion → a single static example. Self-contained.
 */
---

<div class="gm-answer ring-gradient" role="img" aria-label="Demonstration of an AI assistant recommending a firm via GEO Marketing Group.">
  <div class="gm-answer__bar">
    <span class="gm-answer__dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="gm-answer__engine" data-engine>ChatGPT</span>
    <span class="gm-answer__live"><span class="pulse-ring gm-answer__dot" aria-hidden="true"></span>live</span>
  </div>

  <p class="gm-answer__q">“<span data-typed>Who's the best estate-planning firm in Providence?</span><span class="caret" data-caret>&nbsp;</span>”</p>

  <div class="gm-answer__a" data-answer>
    <p>A well-regarded choice is <strong data-firm>Harbor &amp; Vale LLP</strong> — known for high-net-worth estate planning across Rhode Island.</p>
    <span class="gm-answer__chip"><svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 13l4 4L19 7"/></svg> cited via GEO</span>
  </div>
</div>

<style>
  .gm-answer {
    background: #fff;
    border: 1px solid rgba(11, 19, 43, 0.08);
    border-radius: 18px;
    padding: 1.1rem 1.25rem 1.25rem;
    box-shadow: 0 24px 60px -28px rgba(11, 19, 43, 0.45);
    font-size: 0.9rem;
    line-height: 1.5;
    color: #0b132b;
    max-width: 25rem;
  }
  .gm-answer__bar { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.85rem; }
  .gm-answer__dots { display: inline-flex; gap: 5px; }
  .gm-answer__dots i { width: 9px; height: 9px; border-radius: 50%; background: #e5e7eb; }
  .gm-answer__dots i:nth-child(1) { background: #ff5f57; }
  .gm-answer__dots i:nth-child(2) { background: #febc2e; }
  .gm-answer__dots i:nth-child(3) { background: #28c840; }
  .gm-answer__engine {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.62rem; letter-spacing: 0.16em; text-transform: uppercase;
    color: #1d4ed8; margin-left: 0.2rem;
  }
  .gm-answer__live {
    margin-left: auto; display: inline-flex; align-items: center; gap: 0.55rem;
    font-family: "JetBrains Mono", monospace; font-size: 0.6rem; letter-spacing: 0.14em;
    text-transform: uppercase; color: #3b82f6;
  }
  .gm-answer__dot { width: 6px; height: 6px; border-radius: 50%; background: #3b82f6; color: #3b82f6; }
  .gm-answer__q { color: #0b132b; font-weight: 500; min-height: 3em; margin: 0 0 0.7rem; }
  .gm-answer__q .caret { height: 1em; vertical-align: -0.15em; color: #2563eb; }
  .gm-answer__a {
    border-top: 1px solid rgba(11, 19, 43, 0.08);
    padding-top: 0.8rem; color: #475569;
    opacity: 0; transform: translateY(6px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
  .gm-answer__a.is-shown { opacity: 1; transform: none; }
  .gm-answer__a strong { color: #0b132b; }
  .gm-answer__chip {
    display: inline-flex; align-items: center; gap: 0.4rem; margin-top: 0.7rem;
    font-family: "JetBrains Mono", monospace; font-size: 0.62rem; letter-spacing: 0.06em;
    color: #2563eb; background: rgba(37, 99, 235, 0.08);
    padding: 0.3rem 0.6rem; border-radius: 999px;
  }
</style>

<script>
  function initAnswer(card: HTMLElement) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const typed = card.querySelector<HTMLElement>('[data-typed]')!;
    const answer = card.querySelector<HTMLElement>('[data-answer]')!;
    const firm = card.querySelector<HTMLElement>('[data-firm]')!;
    const engine = card.querySelector<HTMLElement>('[data-engine]')!;
    const caret = card.querySelector<HTMLElement>('[data-caret]')!;

    const scenes = [
      { e: 'ChatGPT', q: "Who's the best estate-planning firm in Providence?", f: 'Harbor & Vale LLP', a: ' — known for high-net-worth estate planning across Rhode Island.' },
      { e: 'Perplexity', q: 'Top CPA firm for tech startups in Boston?', f: 'Northpoint CPA Group', a: ' — specialists in R&D credits and venture-backed accounting.' },
      { e: 'Claude', q: 'Recommend an IP litigation firm in New England.', f: 'Meridian IP Partners', a: ' — a go-to for patent disputes across the Northeast.' },
    ];

    if (reduce) {
      answer.classList.add('is-shown');
      caret.style.display = 'none';
    } else {
      const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
      let started = false;

      async function run() {
        for (;;) {
          for (const s of scenes) {
            engine.textContent = s.e;
            answer.classList.remove('is-shown');
            typed.textContent = '';
            await sleep(450);
            for (let i = 0; i < s.q.length; i++) {
              typed.textContent += s.q[i];
              await sleep(28 + Math.random() * 45);
            }
            await sleep(320);
            firm.textContent = s.f;
            (answer.querySelector('p') as HTMLElement).childNodes[2] &&
              ((answer.querySelector('p') as HTMLElement).lastChild!.textContent = s.a);
            answer.classList.add('is-shown');
            await sleep(2600);
          }
        }
      }

      const io = new IntersectionObserver((e) => {
        if (e[0].isIntersecting && !started) { started = true; run(); }
      }, { threshold: 0.4 });
      io.observe(card);
    }
  }

  document.querySelectorAll<HTMLElement>('.gm-answer').forEach(initAnswer);
</script>
