---
import SchemaJsonLd from './SchemaJsonLd.astro';
import { faqPage, type FaqItem } from '../lib/schema';

interface Props {
  items: FaqItem[];
  heading?: string;
  eyebrow?: string;
}

const { items, heading = 'Frequently asked questions', eyebrow = 'FAQ' } = Astro.props;
---

<section class="section">
  <div class="container-prose">
    <p class="eyebrow">{eyebrow}</p>
    <h2 class="font-display text-display-lg mt-2 mb-10">{heading}</h2>
    <div class="space-y-3">
      {items.map((item) => (
        <details class="group rounded-2xl border border-navy/10 bg-white/60 backdrop-blur transition-colors hover:border-navy/20 open:border-electric/40 open:shadow-glow-blue">
          <summary class="flex justify-between items-start gap-4 cursor-pointer list-none px-5 py-5">
            <h3 class="font-display text-lg md:text-xl text-navy group-open:text-electric transition-colors">{item.q}</h3>
            <span class="flex-shrink-0 inline-flex items-center justify-center w-7 h-7 rounded-full bg-navy/[0.04] text-navy text-lg leading-none transition-all group-open:bg-gradient-brand group-open:text-white group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <div class="px-5 pb-5 prose prose-lg max-w-none text-ink/80" set:html={item.a.replace(/\n\n/g, '</p><p>')} />
        </details>
      ))}
    </div>
  </div>
</section>

<SchemaJsonLd schema={faqPage(items)} />
