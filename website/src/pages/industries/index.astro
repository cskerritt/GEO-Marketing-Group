---
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';
import Reveal from '../../components/fx/Reveal.astro';
import { INDUSTRIES } from '../../lib/site';
---

<Base
  title="Industries"
  description="GEO Marketing Group works exclusively with five professional services verticals: law firms, CPAs, consulting, financial advisors, and architecture & engineering. Vertical depth is our moat."
>
  <section class="section">
    <div class="container-prose">
      <Reveal variant="up">
        <p class="eyebrow">Industries</p>
        <h1 class="font-display text-hero mt-2 mb-8">
          Five verticals. <span class="text-gradient-animated">Deep expertise.</span> No exceptions.
        </h1>
        <p class="text-2xl text-ink/85 leading-snug">
          Most agencies chase every client who shows up. We don't. We bring the full stack —
          GEO, SEO, paid, and web — to five professional-services verticals. The deeper we go,
          the faster every campaign compounds.
        </p>
      </Reveal>
    </div>
  </section>

  <section class="bg-cream-light border-y border-navy/10 section">
    <div class="container-default">
      <div class="grid md:grid-cols-2 gap-8">
        {INDUSTRIES.map((industry, i) => (
          <Reveal variant="up" delay={(i % 3) * 80}>
            <a
              href={`/industries/${industry.slug}`}
              class="group block bg-white border border-navy/10 p-8 transition-all hover:border-brass lift ring-gradient h-full"
            >
              <h2 class="font-display text-2xl text-navy group-hover:text-brass transition-colors">
                {industry.title}
              </h2>
              <p class="mt-4 text-ink/80 leading-relaxed">{industry.description}</p>
              <p class="mt-6 font-mono text-sm text-brass">Read the playbook →</p>
            </a>
          </Reveal>
        ))}
      </div>
    </div>
  </section>

  <CTA
    heading="Want a vertical-specific marketing audit?"
    body="Every audit is built around your industry's playbook. Law firms get a different audit than CPAs — because the buyers, the competitive landscape, and the compliance rules are completely different."
    primaryLabel="Get a Free Audit"
  />
</Base>
