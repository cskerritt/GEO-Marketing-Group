---
import Base from '../../layouts/Base.astro';
import FAQ from '../../components/FAQ.astro';
import CTA from '../../components/CTA.astro';
import Reveal from '../../components/fx/Reveal.astro';
import { service as serviceSchema } from '../../lib/schema';

const faqs = [
  {
    q: 'What kind of website do you build?',
    a: 'A 12–15 page website built on a GEO/AEO foundation from day one. We use Astro — a modern static-site framework that produces blazing-fast HTML output (the format AI crawlers prefer). Tailwind CSS for design. Content as Markdown so you can edit easily. Deployed to Cloudflare Pages.',
  },
  {
    q: 'Why Astro and not WordPress?',
    a: 'Three reasons. (1) AI crawlers prefer static HTML — Astro produces the cleanest possible output with no JavaScript-rendered content. (2) Core Web Vitals are a known GEO ranking signal — Astro sites typically score 95+ on Lighthouse out of the box, where WordPress sites struggle without aggressive optimization. (3) Maintenance: WordPress requires ongoing security patches, plugin updates, and hosting fees that Astro doesn\'t. If you have a WordPress site you want to keep, we work with that too — but for new builds, Astro is the right tool.',
  },
  {
    q: 'What pages does the standard Build include?',
    a: 'Home, About, Process/Methodology, Services overview + 3 service detail pages, 2–3 Industry pages (your top verticals), 2 Location pages (your home market + an expansion market), Contact, Insights/Blog scaffolding with 8 launch articles, and a Free Audit lead form. The structure is designed for both SEO and GEO from the start.',
  },
  {
    q: 'Can I add custom features?',
    a: 'Yes — but most clients don\'t need to. The core build covers everything required for a credible, citable, professional services website. Common adds: client portal integration, Calendly embed for booking, custom integrations with your CRM. We discuss these in scoping.',
  },
  {
    q: 'How long does a Build take?',
    a: 'Six weeks from kickoff. Week 1: discovery and content brief. Weeks 2–4: design and content production. Week 5: review and revisions. Week 6: launch. We don\'t do six-month website projects. Discipline on scope keeps us on time.',
  },
  {
    q: 'What about hosting and ongoing maintenance?',
    a: 'Cloudflare Pages hosting is free for traffic levels typical of professional services firms. The domain runs you ~$30/year. The site itself is static — there is no database to maintain, no plugins to patch. Ongoing content updates are part of the retainer if you want them; otherwise you can edit Markdown files yourself.',
  },
  {
    q: 'Can I keep my existing site instead?',
    a: 'Often, yes. If your existing site is on a modern CMS (Webflow, Framer, Next.js, etc.) and the technical foundation is solid, we recommend GEO Foundation ($3,500) instead — we add schema, llms.txt, FAQ scaffolding, and content rewrites to your existing site. The Build is for cases where the existing site is dated, slow, or fundamentally not equipped for GEO.',
  },
];

const phases = [
  { week: 'Week 1', name: 'Discovery & content brief', desc: 'Audit findings reviewed, content priorities locked, sitemap finalized.' },
  { week: 'Weeks 2–4', name: 'Design & content production', desc: 'Design system applied, all pages drafted, schema and infrastructure deployed.' },
  { week: 'Week 5', name: 'Review & revisions', desc: 'Stakeholder walkthrough, feedback addressed, polish applied.' },
  { week: 'Week 6', name: 'Launch', desc: 'DNS cutover, search console, sitemap submission, baseline AI citation reading taken.' },
];
---

<Base
  title="Web Design & Development"
  description="Fast, credible, conversion-focused websites for professional-services firms — built on a GEO/AEO foundation, Astro + Tailwind, deployed to Cloudflare Pages."
  schema={serviceSchema({
    name: 'Web Design & Development',
    description: 'A new website for professional services firms, built on a GEO/AEO foundation.',
    price: '7500.00',
  })}
>
  <section class="section">
    <div class="container-prose">
      <Reveal variant="up">
        <p class="eyebrow">Service · Web Design &amp; Development</p>
        <h1 class="font-display text-hero mt-2 mb-8">
          A website built to <span class="text-gradient-animated">win in search and in AI</span> — from day one.
        </h1>
        <p class="text-2xl text-ink/85 leading-snug">
          12–15 pages. GEO-native from the first line of code. Astro + Tailwind, deployed to
          Cloudflare Pages, six weeks from kickoff to launch — not six months.
        </p>
      </Reveal>
    </div>
  </section>

  <section class="bg-cream-light border-y border-navy/10 section">
    <div class="container-prose">
      <Reveal variant="up">
        <h2 class="font-display text-display-md mb-10">Six-week timeline</h2>
      </Reveal>
      <ol class="space-y-6">
        {phases.map((p, i) => (
          <Reveal variant="left" delay={i * 80} as="li" class="flex gap-6 items-start">
            <div class="flex-shrink-0 font-mono text-sm text-brass w-24 pt-1">{p.week}</div>
            <div class="bg-white border border-navy/10 rounded-xl p-5 flex-1 lift">
              <h3 class="font-display text-xl text-navy">{p.name}</h3>
              <p class="text-ink/80 mt-1">{p.desc}</p>
            </div>
          </Reveal>
        ))}
      </ol>

      <div class="mt-16 grid md:grid-cols-2 gap-6">
        <Reveal variant="up" delay={0}>
          <div class="bg-white border border-navy/10 rounded-2xl p-6 lift ring-gradient relative h-full">
            <p class="eyebrow">GEO Build</p>
            <p class="font-display text-3xl text-navy mt-2">$7,500</p>
            <p class="text-sm text-ink/70 mt-2">12–15 pages, 8 launch articles, full GEO foundation.</p>
          </div>
        </Reveal>
        <Reveal variant="up" delay={90}>
          <div class="bg-white border border-navy/10 rounded-2xl p-6 lift ring-gradient relative h-full">
            <p class="eyebrow">GEO Build + Authority</p>
            <p class="font-display text-3xl text-navy mt-2">$12,500</p>
            <p class="text-sm text-ink/70 mt-2">Adds 5 industry deep-dive pages, 15 articles, founder authority program.</p>
          </div>
        </Reveal>
      </div>

      <Reveal variant="fade" delay={150}>
        <p class="mt-8 text-base text-ink/70 italic">
          Most Build clients pair the project with a $2,500/month Growth retainer for ongoing
          publication, monitoring, and iteration. Total Year-1 investment runs ~$39,000.
        </p>
      </Reveal>
    </div>
  </section>

  <FAQ items={faqs} heading="Frequently asked about web design engagements." />

  <CTA
    heading="Start with an audit. Build with confidence."
    body="The audit tells you — and us — whether a Foundation or a Build is the right next step. No guesswork, no oversell."
    primaryLabel="Get a Free GEO Audit"
  />
</Base>
