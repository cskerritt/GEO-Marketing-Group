---
import Base from '../../layouts/Base.astro';
import Reveal from '../../components/fx/Reveal.astro';
import CTA from '../../components/CTA.astro';
import { service as serviceSchema, breadcrumbs } from '../../lib/schema';
---

<Base
  title="GEO in Boston, MA"
  description="GEO serves Boston-area professional services firms — law, CPA, consulting, financial advisors, and A&E — from our Providence, RI headquarters."
  schema={[
    serviceSchema({
      name: 'GEO services in Boston, MA',
      description: 'Generative Engine Optimization services for Boston-area professional services firms.',
    }),
    breadcrumbs([
      { label: 'Home', href: '/' },
      { label: 'Locations', href: '/locations/providence-ri' },
      { label: 'Boston, MA', href: '/locations/boston-ma' },
    ]),
  ]}
>
  <section class="section">
    <div class="container-prose">
      <Reveal variant="fade">
        <p class="eyebrow">Location · Boston, MA</p>
        <h1 class="font-display text-hero mt-2 mb-8">GEO in <span class="text-gradient-animated">Boston.</span></h1>
        <p class="text-2xl text-ink/85 leading-snug">
          We serve Boston-area professional services firms from our Providence headquarters.
          50 minutes door-to-door means founder-direct attention and in-person meetings
          whenever the relationship calls for it.
        </p>
      </Reveal>
    </div>
  </section>

  <section class="bg-cream-light border-y border-navy/10 section">
    <div class="container-prose prose prose-lg max-w-none">
      <Reveal variant="up" delay={100}>
        <h2>How we work with Boston firms.</h2>
        <p>
          Our Year-1 model is Providence-based, with a select group of Boston and Greater
          Boston clients accepted on a warm-referral basis. By Year 2, Boston becomes a
          primary market with active in-person sales, regular Boston Bar Association
          engagement, and bylined content in Boston Business Journal.
        </p>
        <p>
          Driving time from our Providence office to downtown Boston is 50–60 minutes. We can
          be in your conference room for a kickoff, a partner review, or a strategic check-in
          whenever the relationship calls for it. You get a specialist agency that travels — not
          a local generalist.
        </p>
      </Reveal>

      <Reveal variant="up" delay={150}>
        <h2>Our Boston-area focus</h2>
      </Reveal>
      <ul class="not-prose space-y-3 mt-4 mb-10">
        <Reveal variant="up" delay={200} as="li" class="flex items-start gap-3 text-lg text-ink/85 ring-gradient lift p-4">
          <span class="text-brass font-bold mt-0.5">→</span>
          <span>Boutique and mid-size law firms in Boston, Cambridge, and along Route 128</span>
        </Reveal>
        <Reveal variant="up" delay={250} as="li" class="flex items-start gap-3 text-lg text-ink/85 ring-gradient lift p-4">
          <span class="text-brass font-bold mt-0.5">→</span>
          <span>Mid-size CPA firms in Greater Boston and the Boston suburbs</span>
        </Reveal>
        <Reveal variant="up" delay={300} as="li" class="flex items-start gap-3 text-lg text-ink/85 ring-gradient lift p-4">
          <span class="text-brass font-bold mt-0.5">→</span>
          <span>Boutique consulting firms in Cambridge and the Seaport</span>
        </Reveal>
        <Reveal variant="up" delay={350} as="li" class="flex items-start gap-3 text-lg text-ink/85 ring-gradient lift p-4">
          <span class="text-brass font-bold mt-0.5">→</span>
          <span>RIAs and wealth management firms in MetroWest, Wellesley, and Boston proper</span>
        </Reveal>
        <Reveal variant="up" delay={400} as="li" class="flex items-start gap-3 text-lg text-ink/85 ring-gradient lift p-4">
          <span class="text-brass font-bold mt-0.5">→</span>
          <span>A&amp;E firms across the Boston metro</span>
        </Reveal>
      </ul>

      <Reveal variant="up" delay={150}>
        <h2>Why we're not yet a "Boston agency"</h2>
        <p>
          Honest framing: in 2026, we are a Providence agency that serves Boston clients. By
          2027 we'll have a meaningful Boston client base, regular speaking presence, and trade
          media bylines. By 2028, "GEO" will be a name Boston-area marketing leaders know.
        </p>
        <p>
          We want to earn that reputation — not declare it. If you're a Boston firm signing on
          now, you're early. That means founder-direct attention, faster response times, and
          influence over how we serve your vertical. The firms that come later won't get that.
        </p>
      </Reveal>
    </div>
  </section>

  <CTA
    heading="Boston firm? Want to be one of our first?"
    primaryLabel="Get a Free GEO Audit"
  />
</Base>
