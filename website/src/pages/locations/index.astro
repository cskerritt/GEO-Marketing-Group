---
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';
import Reveal from '../../components/fx/Reveal.astro';
import { STATES, citiesInState, statePath } from '../../data/locations';

const states = STATES.map((s) => ({ ...s, cities: citiesInState(s.slug) }));
const totalCities = states.reduce((n, s) => n + s.cities.length, 0);
---

<Base
  title="Locations — New England"
  description="GEO Marketing Group serves professional-services firms across New England — Rhode Island, Massachusetts, Connecticut, New Hampshire, Maine, and Vermont."
>
  <section class="section">
    <div class="container-default">
      <Reveal>
        <p class="eyebrow">Locations</p>
        <h1 class="font-display text-hero mt-2 mb-6">Marketing for firms across <span class="text-gradient-animated">New England.</span></h1>
        <p class="text-xl text-ink/75 max-w-2xl leading-relaxed">
          We're Providence-based and serve professional-services firms throughout the Northeast.
          Find your market below — {totalCities} cities and growing.
        </p>
      </Reveal>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mt-14">
        {states.map((s, i) => (
          <Reveal variant="up" delay={(i % 3) * 90}>
            <a href={statePath(s)} class="group lift ring-gradient relative block h-full rounded-2xl border border-navy/10 bg-cream-light p-7 hover:shadow-glow-blue">
              <div class="flex items-baseline justify-between">
                <h2 class="font-display text-2xl text-navy group-hover:text-electric transition-colors">{s.name}</h2>
                <span class="font-mono text-xs text-slate">{s.abbr}</span>
              </div>
              <p class="mt-3 text-sm text-ink/70 leading-relaxed">{s.blurb}</p>
              {s.cities.length > 0 && (
                <p class="mt-4 font-mono text-[11px] uppercase tracking-[0.14em] text-electric">{s.cities.length} cities →</p>
              )}
            </a>
          </Reveal>
        ))}
      </div>
    </div>
  </section>

  <CTA
    heading="Not sure if we cover your market?"
    body="We work with firms across New England — and a free GEO Audit tells you exactly where you stand locally and in AI."
    primaryLabel="Get a Free GEO Audit"
  />
</Base>
