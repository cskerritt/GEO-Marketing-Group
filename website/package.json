{
  "name": "geo-website",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.9.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "check": "npm run check:astro && npm run check:functions",
    "check:astro": "astro check",
    "check:functions": "npm run types:functions && tsc --project functions/tsconfig.json --noEmit",
    "test:functions": "node --experimental-strip-types --test test/functions.test.mjs",
    "types:functions": "wrangler types --path='./functions/types.d.ts'",
    "build": "astro build",
    "build:functions": "wrangler pages functions build --outdir .wrangler/functions",
    "verify": "npm run check && npm run test:functions && npm run build && npm run build:functions",
    "preview": "astro preview",
    "pages:dev": "npm run build && wrangler pages dev dist",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.6",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/typography": "^0.5.20",
    "typescript": "^6.0.3",
    "wrangler": "^4.125.0"
  }
}
