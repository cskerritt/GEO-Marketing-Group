# Required for live audits; --dry-run does not need a key.
OPENAI_API_KEY=

# Optional — overrides the default model
# OPENAI_MODEL=gpt-4.1

# Optional — Google PageSpeed Insights key (works keyless at low volume).
# If set, Core Web Vitals + Lighthouse SEO are added to the technical score.
# PAGESPEED_API_KEY=
